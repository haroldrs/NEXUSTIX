# Una copia por clúster: backup-usuarios.env, backup-eventos.env, backup-compras.env.
# El usuario de sistema nexustix-backup debe poder leer PGPASSFILE (0600).
PGHOST=192.168.56.12
PGPORT=5432
PGUSER=replicator
PGPASSFILE=/etc/nexustix/backup.pgpass
NEXUSTIX_PG_BIN=/usr/pgsql-15/bin
NEXUSTIX_BACKUP_ROOT=/var/lib/nexustix/backups/usuarios
