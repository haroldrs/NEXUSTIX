# Ejemplo de configuración del entorno DEMO (proyecto Compose "nexustix").
# No contiene secretos: solo rutas y parámetros. Los secretos los genera
#   python3 scripts/nx.py demo secretos
# Uso opcional: copiar a ".env" en la raíz del proyecto, o exportar en la shell.
# scripts/nx.py ya fija NEXUSTIX_SECRETS_DIR por usted.

# Carpeta de secretos (fuera del repositorio).
NEXUSTIX_SECRETS_DIR=/home/USUARIO/.config/nexustix/demo-secrets

# Dirección en la que se publican 8001-8005 y 8080.
#   127.0.0.1 -> solo esta PC (por defecto, recomendado)
#   0.0.0.0   -> accesible desde la red (dos PC; abra los puertos en firewalld)
NEXUSTIX_BIND_ADDRESS=127.0.0.1

# Orígenes permitidos por CORS y CSRF (URL exacta con la que se abre el frontend).
NEXUSTIX_FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Cookie de refresco "Secure": solo true si el frontend se sirve por HTTPS.
NEXUSTIX_AUTH_COOKIE_SECURE=false

# Vida del token de acceso (segundos).
NEXUSTIX_ACCESS_TOKEN_TTL_SECONDS=600

# Barrido automático de recuperación de Compras (0 desactiva). Solo confirma
# reservas de compras ya persistidas; nunca libera stock por sí solo.
NEXUSTIX_RECOVERY_INTERVAL_SECONDS=30

# Solo para ACTUALIZAR una instalación anterior cuyos volúmenes se llamaban
# <prefijo>_usuarios_data, etc. (p. ej. "project" si la carpeta era Project/).
# En una instalación nueva déjelo comentado.
# NEXUSTIX_VOLUME_PREFIX=project
