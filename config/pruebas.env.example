# Ejemplo de configuración del entorno de PRUEBAS aislado (proyecto
# "nexustix-auth-staging", puertos 127.0.0.1:18080-18085). Sin secretos.
#   python3 scripts/nx.py pruebas secretos
# Exporte estas variables en la shell antes de las pruebas (no las ponga en
# .env: ese archivo es del entorno demo).

export NEXUSTIX_STAGING_SECRETS_DIR="$HOME/.config/nexustix-auth-staging-secrets"

# Habilita las suites que actúan sobre el entorno de pruebas.
export NEXUSTIX_STAGING_HTTP=1

# Administrador sintético que crean las pruebas (contraseña en admin-password).
export NEXUSTIX_STAGING_ADMIN_EMAIL=qa-admin@example.com
export NEXUSTIX_STAGING_ADMIN_PASSWORD_FILE="$NEXUSTIX_STAGING_SECRETS_DIR/admin-password"

# Opcional: barrido automático de recuperación para test_r17 (0 = manual).
# Debe definirse ANTES de "nx.py pruebas up".
# export NEXUSTIX_STAGING_RECOVERY_INTERVAL_SECONDS=10

# Opcional: TTL corto del token para las suites de renovación (tests/staging).
# export NEXUSTIX_STAGING_ACCESS_TOKEN_TTL_SECONDS=15
